rules_version = '2';

// RBAC：每個人一筆文件放在 users/{email}，欄位 email + role（"editor" | "viewer"）。
// users 文件本身禁止任何角色透過 App 寫入，只能由專案管理者在 Firebase Console 手動新增/編輯，
// 避免任何登入者透過用戶端 SDK 幫自己加名單、自我提權。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/userid/$(signedInEmail())).data.role;
    }

    function isViewerOrAbove() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/userid/$(signedInEmail()))
        && myRole() in ['viewer', 'editor'];
    }

    function isEditor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/userid/$(signedInEmail()))
        && myRole() == 'editor';
    }

    // 每個人只能讀自己那筆（用來確認自己的角色），不能讀別人的，也不能透過 App 寫入。
    match /userid/{userId} {
      allow read: if isSignedIn() && userId == signedInEmail();
      allow write: if false;
    }

    match /iso_courses/{docId} {
      allow read: if isViewerOrAbove();
      allow write: if isEditor();
    }

    match /iso_categories/{docId} {
      allow read: if isViewerOrAbove();
      allow write: if isEditor();
    }

    match /iso_cert_levels/{docId} {
      allow read: if isViewerOrAbove();
      allow write: if isEditor();
    }

    match /iso_meta/{docId} {
      allow read: if isViewerOrAbove();
      allow write: if isEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
